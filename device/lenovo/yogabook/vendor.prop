# Vendor properties for Yoga Book YB1-91F

# Audio
persist.vendor.audio.fluence.voicecall=true
persist.vendor.audio.fluence.voicerec=false
persist.vendor.audio.fluence.videorec=false
persist.vendor.audio.ras.enabled=false
persist.vendor.audio.spv3.enable=true

# Camera
persist.vendor.camera.aux.packagelist=org.codeaurora.snapcam,com.android.camera
persist.vendor.camera.expose.aux=1

# Display
ro.vendor.display.cabl=2
ro.vendor.display.sensormode=2

# HaloKeyboard
ro.vendor.halokeyboard.enabled=true
persist.vendor.halokeyboard.dev=/dev/input/event0

# Sensors
ro.vendor.sensors.multishake_enable=false
ro.vendor.sensors.pmd=true
ro.vendor.sensors.sta_detect=true