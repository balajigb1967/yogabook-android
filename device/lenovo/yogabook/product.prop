# Product properties for Yoga Book YB1-91F

# HaloKeyboard
ro.product.halokeyboard.enabled=true

# Camera
ro.product.camera.front.packagelist=org.codeaurora.snapcam,com.android.camera

# Sensors
ro.product.sensors.orientation=true
ro.product.sensors.proximity_aware=true

# LTE
ro.product.lte.bands=1,2,3,4,5,7,8,20,28,38,39,40,41