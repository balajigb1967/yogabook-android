# Yoga Book (Lenovo YB1-X90/X91, Cherry Trail x5-Z8550) hardware fragment.
# Merged after the Debian-filtered config by the mainline generic kernel
# pipeline. Only additive symbols live here.

# ---- Audio: Realtek RT5677 + Intel SST + Yoga Book machine driver ----------
# Machine driver comes from jekhor's b4/asoc-yogabook-v4 series
# (CONFIG symbol SND_SOC_INTEL_CHT_RT5677_MACH).
CONFIG_SND_SOC_RT5677=y
CONFIG_SND_SOC_INTEL_CHT_RT5677_MACH=y
CONFIG_SND_SOC_TS3A227E=y
CONFIG_SND_SOC_INTEL_SST=y
CONFIG_SND_SOC_SST_CHT=y

# ---- Haptics: TI DRV2604/DRV2605 (Halo keyboard key feedback) -------------
CONFIG_INPUT_DRV260X_HAPTICS=y

# ---- Input: keyboard surface + pen ----------------------------------------
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_INPUT_WACOM=y
CONFIG_INPUT_WACOM_I2C=y
CONFIG_I2C_HID_OF=y
CONFIG_I2C_HID_ACPI=y

# ---- Camera: AtomISP (staging) for Cherry Trail MIPI sensors ---------------
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_INTEL_ATOMISP=y
CONFIG_VIDEO_ATOMISP=y
CONFIG_INTEL_IPU_BRIDGE=y

# ---- Wi-Fi (BCM4356) / Bluetooth ------------------------------------------
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMUTIL=y
CONFIG_BT=y
CONFIG_BT_BCM=y

# ---- LTE (Intel XMM7260 on SSIC/xHCI): MBIM + serial fallbacks -------------
CONFIG_USB_NET_CDC_MBIM=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_WDM=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_QMI_WWAN=y

# ---- Intel Cherry Trail SoC Platform, GPIO, LPSS, I2C & PMIC ---------------
# Required for on-board MicroSD slot, eMMC 5.0, PWM backlight, and regulators
CONFIG_PINCTRL=y
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_ACPI=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_IOSF_MBI=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_BAYTRAIL=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_INTEL_SOC_PMIC=y
CONFIG_INTEL_SOC_PMIC_CHTWC=y
CONFIG_INTEL_SOC_PMIC_CHTDC_TI=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_INTEL_CHT_INT33FE=y
CONFIG_PWM=y
CONFIG_PWM_CRC=y
CONFIG_AXP288_CHARGER=y
CONFIG_AXP288_FUEL_GAUGE=y
CONFIG_AXP288_ADC=y
CONFIG_EXTCON=y
CONFIG_EXTCON_AXP288=y
CONFIG_PMIC_OPREGION=y
CONFIG_CHT_WC_PMIC_OPREGION=y
CONFIG_CHT_DC_TI_PMIC_OPREGION=y
CONFIG_BYT_CRC_PMIC_OPREGION=y
CONFIG_AXP288_PMIC_OPREGION=y

# ---- Storage & MMC (Built-in for early eMMC and SD card detection) -------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MMC_CQHCI=y
CONFIG_BLK_DEV_SD=y
CONFIG_CHR_DEV_SG=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ---- Display & Framebuffer Console (Early boot text & rotation) -----------
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y

# ---- Misc platform bits ----------------------------------------------------
CONFIG_RTC_DRV_CMOS=y
CONFIG_X86_ANDROID_TABLETS=y

# ---- Build & Size Optimizations (essential for CI runner disk space) -------
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_WERROR=n

# ---- Installer & Live Boot Support -----------------------------------------
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZ4=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_EROFS_FS_ONDEMAND=y


