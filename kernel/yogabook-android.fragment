# Yoga Book (YB1-X91F) -> Bass/Bliss 16.9.7 (Android-x86, Android 13)
# Merged on top of the Yoga-Book org's VALIDATED X91 config (extracted from
# their published linux-image .deb — the config behind their "touchscreen,
# sound, halo keyboard, pen, Wi-Fi working on 7.2" validation).
#
# This fragment only ADDS Android-runtime and live-boot symbols; everything
# hardware-specific (HiDeep touchscreen, Goodix halo, Wacom digitizer, RT5677
# sound, brcmfmac, battery/charger, sensors, LTE) is inherited untouched.

# ---- Android runtime requirements ----
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# lmkd / Android memory management
CONFIG_PSI=y
CONFIG_MEMCG=y

# ---- Android-x86 live-boot essentials (initrd) ----
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXT2_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# ---- Early graphics ----
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---- Yoga Book input devices as seen by Android userspace ----
CONFIG_INPUT_UINPUT=y
CONFIG_HIDRAW=y
CONFIG_UHID=y

# ---- Versioning ----
CONFIG_LOCALVERSION="-yogabook-bass"
CONFIG_LOCALVERSION_AUTO=n

# ---- Build-environment neutralization ----
# Their .deb config may point at signing/trusted keys that only exist in
# their build env; empty them so our build doesn't fail on missing files.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# ---- No DWARF/BTF needed for Android ----
# Their deb config carries Ubuntu's DEBUG_INFO_BTF=y; the resolve_btfids
# host tool is fragile on CI and BTF is not used by Android-x86 at all.
# Disabling also shrinks vmlinux and cuts build time substantially.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
