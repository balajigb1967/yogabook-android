# Yoga Book (YB1-X91F) -> Bass/Bliss 16.9.7 (Android-x86, Android 13)
# Merged on top of the Yoga-Book org's VALIDATED X91 config (extracted from
# their published linux-image .deb — the config behind their "touchscreen,
# sound, halo keyboard, pen, Wi-Fi working on 7.2" validation).
#
# This fragment only ADDS Android-runtime and live-boot symbols; everything
# hardware-specific (HiDeep touchscreen, Goodix halo, Wacom digitizer, RT5677
# sound, brcmfmac, battery/charger, sensors, LTE) is inherited untouched.

# ---- Android runtime requirements ----
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# lmkd / Android memory management
CONFIG_PSI=y
CONFIG_MEMCG=y

# ---- Security / SELinux (Required by Android 13 userspace) ----
# Base Ubuntu kernel defaults to AppArmor; Android init requires SELinux
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
# CONFIG_DEFAULT_SECURITY_APPARMOR is not set
CONFIG_LSM="landlock,lockdown,yama,integrity,selinux"


# ---- Android-x86 live-boot essentials (initrd) ----
CONFIG_BLK_DEV_INITRD=y
# initramfs decompression support — must cover however we repack the initrd
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_LZ4=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXT2_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# ---- Early graphics ----
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---- Yoga Book hardware drivers built-in (PMIC, battery, charger, backlight, touch) ----
# Built directly into bzImage so Android's battery service, backlight, and touch work
# immediately upon boot without relying on modular insmod.
CONFIG_INTEL_SOC_PMIC_CHTDC_TI=y
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
CONFIG_CHARGER_BQ25890=y
CONFIG_AXP288_CHARGER=y
CONFIG_AXP288_FUEL_GAUGE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_TOUCHSCREEN_HIDEEP=y
CONFIG_HID_GOODIX_SPI=y

# ---- Yoga Book input devices as seen by Android userspace ----
CONFIG_INPUT_UINPUT=y
CONFIG_HIDRAW=y
CONFIG_UHID=y

# ---- Versioning ----
CONFIG_LOCALVERSION="-yogabook-bass"
CONFIG_LOCALVERSION_AUTO=n

# ---- Build-environment neutralization ----
# Their .deb config may point at signing/trusted keys that only exist in
# their build env; empty them so our build doesn't fail on missing files.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# Modules must ship UNCOMPRESSED: busybox modprobe in the installer initrd
# cannot load .ko.zst, and every USB-storage/SD/HID module load would
# silently fail ("Detecting Android-x86..." forever). (Their own deb ships
# plain .ko despite this same CONFIG_MODULE_COMPRESS_ZSTD=y in the config.)
CONFIG_MODULE_COMPRESS=n

# ---- No DWARF/BTF needed for Android ----
# Their deb config carries Ubuntu's DEBUG_INFO_BTF=y; the resolve_btfids
# host tool is fragile on CI and BTF is not used by Android-x86 at all.
# Disabling also shrinks vmlinux and cuts build time substantially.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
